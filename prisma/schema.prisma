generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  MASTER
  SECRETARY
  EVALUATOR
}

enum SessionStatus {
  DRAFT
  IN_PROGRESS
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum AssignmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// 평가항목 검토 상태: 간사 입력중(DRAFT) → 제출(SUBMITTED) → 관리자 승인(APPROVED)/반려(REJECTED)
enum CriteriaStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// 평가위원 배정 검토 상태: 간사 배정중(DRAFT) → 제출(SUBMITTED) → 관리자 승인(APPROVED)/반려(REJECTED)
enum EvaluatorStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// 공통 검토 상태(평가 대상·평가 의견서): 간사 작성/취합(DRAFT) → 제출(SUBMITTED) → 관리자 승인(APPROVED)/반려(REJECTED)
enum ReviewStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  // 관리자가 발급한 임시 비밀번호(참조용). 위원이 직접 변경 기능은 없음.
  tempPassword String?
  name         String
  // 연락처(전화/휴대폰) — 평가위원 안내용. 선택 입력.
  phone        String?
  role         Role
  assignments  Assignment[]
  scores       Score[]
  createdAt    DateTime     @default(now())

  assignedProjects    Project[]           @relation("ProjectSecretaries")
  secretariedSessions EvaluationSession[] @relation("SessionSecretary")
}

model Project {
  id          String              @id @default(cuid())
  name        String
  description String?
  // 인쇄 평가표 헤더용 — 과제유형(예: 지역특화 R&D). 과제명은 name을 사용.
  taskType    String?
  // (레거시) 평가일 — 기간(startDate/endDate)으로 대체. 컬럼은 보존.
  dueDate     DateTime?
  // 과제 수행 기간
  startDate   DateTime?
  endDate     DateTime?
  // 집계 환산·등급 기준 만점(기본 100). 평가항목 배점 합계는 이 값과 일치해야 하며, 소속 분과 maxScore의 원본.
  maxScore    Int                 @default(100)
  secretaries User[]              @relation("ProjectSecretaries")
  sessions    EvaluationSession[]
  // 평가항목은 과제 단위(모든 분과 공통) — 관리자가 작성, 간사는 확인
  criteria        Criterion[]
  criterionGroups CriterionGroup[]
  createdAt   DateTime            @default(now())
}

model EvaluationSession {
  id              String           @id @default(cuid())
  name            String
  description     String?
  // 평가 기간(시작일/종료일). eventDate는 마감 판정·평가화면 안내용으로 종료일과 동기화 유지.
  startDate       DateTime?
  endDate         DateTime?
  eventDate       DateTime?
  location        String?
  status          SessionStatus    @default(DRAFT)
  // 집계 환산·등급 기준 만점(기본 100). 평가항목 배점 합계는 이 값과 정확히 일치해야 함.
  maxScore        Int              @default(100)
  // 평가위원장(배정 위원 중 1인)의 userId — 총괄평가/타 위원 점수 열람 권한
  chairId         String?
  // 위원장이 작성하는 심사 전체 총평(1건)
  chairSummary    String?
  // 간사가 집계 결과를 '제출 완료'한 시각. null이면 제출 전(제출중) — 관리자는 이 값이 있어야 '검토 완료' 가능.
  submittedForReviewAt DateTime?
  // (레거시) 평가항목 검토 상태 — 평가항목이 과제 단위로 이동하면서 미사용. 컬럼은 보존.
  criteriaStatus          CriteriaStatus  @default(DRAFT)
  criteriaRejectionReason String?
  // 담당 간사가 과제 공통 평가항목을 '확인'한 시각(null = 미확인)
  criteriaAckAt           DateTime?
  // 평가위원 배정 검토 상태. 간사 제출 전(DRAFT/REJECTED)에는 관리자가 배정을 볼 수 없고, 제출(SUBMITTED) 후 승인/반려한다.
  evaluatorStatus          EvaluatorStatus @default(DRAFT)
  evaluatorRejectionReason String?
  // 평가 대상 검토 상태(간사 제출 → 관리자 승인/반려)
  subjectReviewStatus          ReviewStatus @default(DRAFT)
  subjectReviewRejectionReason String?
  // 평가 의견서 검토 상태(간사 제출 → 관리자 승인/반려)
  opinionStatus          ReviewStatus @default(DRAFT)
  opinionRejectionReason String?
  criteria        Criterion[]
  criterionGroups CriterionGroup[]
  subjects        Subject[]
  assignments     Assignment[]
  scores          Score[]
  submissions     Submission[]
  documents       Document[]
  createdAt       DateTime         @default(now())

  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  secretaryId String?
  secretary   User?    @relation("SessionSecretary", fields: [secretaryId], references: [id], onDelete: SetNull)
}

// 평가항목은 과제(Project) 단위로 관리한다(과제의 모든 분과 공통).
// sessionId는 과제 단위 이전(移轉) 전의 레거시 스코프 — 신규 데이터는 projectId만 사용.
model Criterion {
  id        String             @id @default(cuid())
  projectId String?
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionId String?
  session   EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  maxScore  Float
  weight    Float              @default(1)
  order     Int                @default(0)
  subitemId String
  subitem   CriterionSubitem   @relation(fields: [subitemId], references: [id], onDelete: Cascade)
  scores    Score[]

  @@index([projectId])
}

model CriterionGroup {
  id        String             @id @default(cuid())
  projectId String?
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionId String?
  session   EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  maxScore  Float              @default(0)
  order     Int                @default(0)
  subitems  CriterionSubitem[]

  @@index([sessionId])
  @@index([projectId])
}

model CriterionSubitem {
  id       String         @id @default(cuid())
  groupId  String
  group    CriterionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name     String
  order    Int            @default(0)
  criteria Criterion[]

  @@index([groupId])
}

// 전역 기업(평가 대상 원본) — 회차에 묶이지 않으며 자료를 회차 간 공유
model Company {
  id          String     @id @default(cuid())
  name        String     @unique
  // 사업자등록번호 (예: 123-45-67890)
  businessNo  String?
  // 인쇄 평가표 헤더용(기업 단위) — 지역·연구책임자
  region         String?
  leadResearcher String?
  description String?
  documents   Document[]
  subjects    Subject[]
  createdAt   DateTime   @default(now())
}

// 회차에 편입된 평가 대상 (기업 ↔ 회차 연결)
model Subject {
  id          String            @id @default(cuid())
  sessionId   String
  session     EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int               @default(0)
  // 관리자 검토 상태 — 간사 등록분은 PENDING, 관리자 승인/반려
  status         SubjectStatus  @default(PENDING)
  rejectionReason String?
  decidedAt      DateTime?
  scores      Score[]

  @@unique([sessionId, companyId])
}

enum SubjectStatus {
  PENDING
  APPROVED
  REJECTED
}

model Document {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // 자료가 특정 심사 회차용이면 sessionId 지정, null이면 공통(전 회차)
  sessionId    String?
  session      EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  originalName String
  storedName   String
  url          String? // Vercel Blob URL(있으면 Blob, 없으면 로컬 디스크)
  mimeType     String
  size         Int
  createdAt    DateTime           @default(now())
}

model Assignment {
  id          String            @id @default(cuid())
  sessionId   String
  session     EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AssignmentStatus  @default(PENDING)
  createdById String?
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?
  rejectionReason String?

  @@unique([sessionId, userId])
}

// 위원이 대상별로 남기는 종합의견
model Opinion {
  id          String   @id @default(cuid())
  sessionId   String
  evaluatorId String
  subjectId   String
  text        String
  updatedAt   DateTime @updatedAt

  @@unique([evaluatorId, subjectId])
}

// 평가위원이 현재 입력 중인 항목(실시간 표시용). 위원당 1개 활성 항목, updatedAt 신선도로 만료 판단.
model EditingPresence {
  evaluatorId String   @id
  sessionId   String
  subjectId   String
  criterionId String
  updatedAt   DateTime
}

model Score {
  id          String            @id @default(cuid())
  sessionId   String
  session     EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluatorId String
  evaluator   User              @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   Criterion         @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  value       Float
  grade       String?
  comment     String?
  updatedAt   DateTime          @updatedAt

  @@unique([evaluatorId, subjectId, criterionId])
}

// (위원 × 대상)별 제출/승인 상태
model Submission {
  id          String            @id @default(cuid())
  sessionId   String
  session     EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluatorId String
  subjectId   String
  status      SubmissionStatus  @default(DRAFT)
  submittedAt DateTime?
  decidedAt   DateTime?
  decidedById String?
  updatedAt   DateTime          @updatedAt

  @@unique([evaluatorId, subjectId])
  @@index([sessionId])
}
