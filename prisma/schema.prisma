generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  MASTER
  SECRETARY
  EVALUATOR
}

enum SessionStatus {
  DRAFT
  IN_PROGRESS
  CLOSED
}

enum CriterionType {
  QUANTITATIVE
  QUALITATIVE
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  // 관리자가 발급한 임시 비밀번호(참조용). 위원이 직접 변경 기능은 없음.
  tempPassword String?
  name         String
  // 연락처(전화/휴대폰) — 평가위원 안내용. 선택 입력.
  phone        String?
  role         Role
  assignments  Assignment[]
  scores       Score[]
  createdAt    DateTime     @default(now())

  assignedProjects    Project[]           @relation("ProjectSecretaries")
  secretariedSessions EvaluationSession[] @relation("SessionSecretary")
}

model Project {
  id          String              @id @default(cuid())
  name        String
  description String?
  dueDate     DateTime?
  secretaries User[]              @relation("ProjectSecretaries")
  sessions    EvaluationSession[]
  createdAt   DateTime            @default(now())
}

model EvaluationSession {
  id          String            @id @default(cuid())
  name        String
  description String?
  eventDate   DateTime?
  location    String?
  status      SessionStatus     @default(DRAFT)
  // 평가위원장(배정 위원 중 1인)의 userId — 총괄평가/타 위원 점수 열람 권한
  chairId      String?
  // 위원장이 작성하는 심사 전체 총평(1건)
  chairSummary String?
  criteria    Criterion[]
  subjects    Subject[]
  assignments Assignment[]
  scores      Score[]
  documents   Document[]
  createdAt   DateTime          @default(now())

  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  secretaryId String?
  secretary   User?             @relation("SessionSecretary", fields: [secretaryId], references: [id], onDelete: SetNull)
}

model Criterion {
  id          String            @id @default(cuid())
  sessionId   String
  session     EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // 대제목(섹션): 사업계획/추진역량/기대효과 등. 이 아래의 세부항목이 곧 Criterion.
  section     String?
  name        String
  description String?
  type        CriterionType
  maxScore    Float
  weight      Float             @default(1)
  order       Int               @default(0)
  // 정성 항목의 등급(답) 정의: [{ label, points }] — 없으면 기본 A~E 척도
  gradeOptions Json?
  scores      Score[]
}

// 전역 기업(평가 대상 원본) — 회차에 묶이지 않으며 자료를 회차 간 공유
model Company {
  id          String     @id @default(cuid())
  name        String     @unique
  // 사업자등록번호 (예: 123-45-67890)
  businessNo  String?
  description String?
  documents   Document[]
  subjects    Subject[]
  createdAt   DateTime   @default(now())
}

// 회차에 편입된 평가 대상 (기업 ↔ 회차 연결)
model Subject {
  id          String            @id @default(cuid())
  sessionId   String
  session     EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int               @default(0)
  scores      Score[]

  @@unique([sessionId, companyId])
}

model Document {
  id           String             @id @default(cuid())
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // 자료가 특정 심사 회차용이면 sessionId 지정, null이면 공통(전 회차)
  sessionId    String?
  session      EvaluationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  originalName String
  storedName   String
  url          String? // Vercel Blob URL(있으면 Blob, 없으면 로컬 디스크)
  mimeType     String
  size         Int
  createdAt    DateTime           @default(now())
}

model CriterionTemplate {
  id        String                  @id @default(cuid())
  name      String                  @unique
  items     CriterionTemplateItem[]
  createdAt DateTime                @default(now())
}

model CriterionTemplateItem {
  id          String            @id @default(cuid())
  templateId  String
  template    CriterionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        CriterionType
  maxScore    Float
  weight      Float             @default(1)
  order       Int               @default(0)
}

model Assignment {
  id        String            @id @default(cuid())
  sessionId String
  session   EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

// 위원이 대상별로 남기는 종합의견
model Opinion {
  id          String   @id @default(cuid())
  sessionId   String
  evaluatorId String
  subjectId   String
  text        String
  updatedAt   DateTime @updatedAt

  @@unique([evaluatorId, subjectId])
}

// 평가위원이 현재 입력 중인 항목(실시간 표시용). 위원당 1개 활성 항목, updatedAt 신선도로 만료 판단.
model EditingPresence {
  evaluatorId String   @id
  sessionId   String
  subjectId   String
  criterionId String
  updatedAt   DateTime
}

model Score {
  id          String            @id @default(cuid())
  sessionId   String
  session     EvaluationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluatorId String
  evaluator   User              @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  criterionId String
  criterion   Criterion         @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  value       Float
  grade       String?
  comment     String?
  updatedAt   DateTime          @updatedAt

  @@unique([evaluatorId, subjectId, criterionId])
}
